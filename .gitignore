.pio/
.vscode/
*.o
*.a
pi/.venv/
pi/__pycache__/
**/__pycache__/
*.pyc

# Local config/logs (pi/config.example.json is the tracked template) --
# never commit an actual deployment's config or log output.
pi/config.json
pi/logs/

# rover-ai credentials (API key or local LLM address, ARCHITECTURE_AND_ROADMAP.md
# §17.1) -- pi/ai_credentials.example.json is the tracked template, never
# the real file (same reasoning as pi/config.json above, but this one
# can hold a real secret).
pi/ai_credentials.json

# TLS cert/key (pi/README.md "HTTPS/WSS") and the systemd env file
# (pi/rover.env.example is the tracked template) -- generated/filled in
# locally per deployment, never committed.
pi/*.pem
pi/*.crt
pi/*.key
pi/rover.env

# WireGuard configs (pi/VPN.md) contain private keys -- only the
# .example.conf templates are tracked.
pi/wireguard/wg0.conf
pi/wireguard/client.conf

# Never commit real WiFi/OTA credentials (esp32/OTA.md) -- those are
# meant to be set as environment variables, not files, but this is a
# backstop in case a future contributor adds a local credentials file
# out of habit from another project.
esp32/**/wifi_credentials*
esp32/**/*secrets*
esp32-cam/**/wifi_credentials*
esp32-cam/**/*secrets*

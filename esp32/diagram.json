{
  "version": 1,
  "author": "Rover Project",
  "editor": "wokwi",
  "//": "Phase 1+2+3+4. UART0 -> moniteur serie (Rover Protocol). 4 LEDs sur les pins moteur DRV8833 (IN1/IN2 gauche+droite) pour visualiser direction/PWM sans moteur reel -- pas de retour d'encodeur simule, donc la boucle PID tourne en boucle ouverte en simulation. 2 servos (pitch/yaw) + 1 ecran ST7789 (yeux/emotions) pour la Phase 3. Phase 4 : MPU6050 simule (chip Wokwi officiel) sur le bus I2C partage -- VL53L0X et BME688 n'ont PAS de chip Wokwi officiel (ni de chip communautaire fiable trouve a ce jour) donc restent absents de ce diagramme ; leur dispatch protocole (FACE/HEAD/etc. gere pareil) est deja valide via la sonde de presence I2C (voir sensors_config.h/I2CProbe.h) et sur ESP32 physique reel (PROGRESS.md 2026-08-31), juste pas visuellement/electriquement en simulation. Voir WIRING.md.",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp32",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    { "type": "wokwi-led", "id": "led_l_fwd", "top": -20, "left": 200, "attrs": { "color": "green", "label": "L_IN1 (fwd)" } },
    { "type": "wokwi-led", "id": "led_l_rev", "top": 20, "left": 200, "attrs": { "color": "red", "label": "L_IN2 (rev)" } },
    { "type": "wokwi-led", "id": "led_r_fwd", "top": -20, "left": 260, "attrs": { "color": "green", "label": "R_IN1 (fwd)" } },
    { "type": "wokwi-led", "id": "led_r_rev", "top": 20, "left": 260, "attrs": { "color": "red", "label": "R_IN2 (rev)" } },
    { "type": "wokwi-resistor", "id": "r_l_fwd", "top": -20, "left": 160, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_l_rev", "top": 20, "left": 160, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_r_fwd", "top": -20, "left": 320, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_r_rev", "top": 20, "left": 320, "attrs": { "value": "220" } },
    { "type": "wokwi-servo", "id": "servo_pitch", "top": -120, "left": 200, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo_yaw", "top": -120, "left": 320, "attrs": {} },
    { "type": "board-st7789", "id": "display", "top": -260, "left": 200, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "imu", "top": 40, "left": 400, "attrs": {} }
  ],
  "connections": [
    [ "esp32:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp32:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp32:D27", "r_l_fwd:1", "", [] ],
    [ "r_l_fwd:2", "led_l_fwd:A", "", [] ],
    [ "led_l_fwd:C", "esp32:GND.1", "", [] ],

    [ "esp32:D26", "r_l_rev:1", "", [] ],
    [ "r_l_rev:2", "led_l_rev:A", "", [] ],
    [ "led_l_rev:C", "esp32:GND.1", "", [] ],

    [ "esp32:D33", "r_r_fwd:1", "", [] ],
    [ "r_r_fwd:2", "led_r_fwd:A", "", [] ],
    [ "led_r_fwd:C", "esp32:GND.2", "", [] ],

    [ "esp32:D32", "r_r_rev:1", "", [] ],
    [ "r_r_rev:2", "led_r_rev:A", "", [] ],
    [ "led_r_rev:C", "esp32:GND.2", "", [] ],

    [ "esp32:D13", "servo_pitch:PWM", "", [] ],
    [ "servo_pitch:GND", "esp32:GND.1", "", [] ],
    [ "servo_pitch:V+", "esp32:VIN", "", [] ],

    [ "esp32:D19", "servo_yaw:PWM", "", [] ],
    [ "servo_yaw:GND", "esp32:GND.2", "", [] ],
    [ "servo_yaw:V+", "esp32:VIN", "", [] ],

    [ "esp32:D18", "display:SCL", "", [] ],
    [ "esp32:D23", "display:SDA", "", [] ],
    [ "esp32:D5", "display:CS", "", [] ],
    [ "esp32:D2", "display:DC", "", [] ],
    [ "esp32:D15", "display:RST", "", [] ],
    [ "display:BL", "esp32:3V3", "", [] ],
    [ "display:VCC", "esp32:3V3", "", [] ],
    [ "display:GND", "esp32:GND.1", "", [] ],

    [ "esp32:D21", "imu:SDA", "", [] ],
    [ "esp32:D22", "imu:SCL", "", [] ],
    [ "imu:VCC", "esp32:3V3", "", [] ],
    [ "imu:GND", "esp32:GND.2", "", [] ]
  ],
  "dependencies": {}
}
